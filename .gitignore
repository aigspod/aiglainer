# environments and caches
.venv/
.pixi/
__pycache__/
*.egg-info/
build/
dist/
.DS_Store

# build outputs and synthesized narration (regenerate with `make`)
projects/*/out/
projects/*/cache/
projects/*/tex/*.aux
projects/*/tex/*.log
projects/*/tex/*.pdf

# heavy media: never commit renders, audio or video
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.m4a
*.mp3
*.aac
*.flac

# papers: keep PDFs local (copyright; data/ holds what the build needs)
*.pdf

# voice auditions are regenerated by `make voices`
projects/*/voice_samples/*
!projects/*/voice_samples/sample.txt

# the lockfile is the pinned environment for this repo (overrides a global ignore)
!pixi.lock
